# Copie para .env e preencha com valores apropriados; nunca coloque credenciais reais
# neste arquivo de exemplo nem o versionamento.

# Banco legado
DB_LEGADO_HOST=localhost
DB_LEGADO_PORT=3306
DB_LEGADO_DATABASE=nome_do_banco_legado
DB_LEGADO_USERNAME=usuario_leitura
DB_LEGADO_PASSWORD=troque_esta_senha

# Fonte exclusiva do botão "Atualizar Relatório Base".
# Se DB_RELATORIO_HOST estiver definido, o botão lê desta conexão em vez de
# DB_LEGADO_* — é assim que o servidor de testes passa a atualizar o relatório
# a partir do banco legado da máquina de desenvolvimento. Deixe comentado para
# manter o comportamento antigo.
# DB_RELATORIO_HOST=172.16.0.121
# DB_RELATORIO_PORT=3308
# DB_RELATORIO_DATABASE=aluguel_legado
# DB_RELATORIO_USERNAME=leitura_legado
# DB_RELATORIO_PASSWORD=troque_esta_senha

# Ponte que expõe o MySQL local na rede (serviço db-relay, profile relatorio-local).
# RELAY_BIND precisa ser o IP desta máquina na LAN que o servidor de testes alcança.
# RELAY_BIND=172.16.0.121
# RELAY_PORTA=3308

# Banco novo local publicado pelo Compose (execução do app diretamente no host).
# Para o app em container e o MySQL do mesmo Compose, use banco-novo:3306.
DB_NOVO_HOST=localhost
DB_NOVO_PORT=3307
DB_NOVO_DATABASE=controle-interno
DB_NOVO_USERNAME=root
DB_NOVO_PASSWORD=troque_esta_senha

# A senha do banco novo também é usada pelo serviço MySQL como senha do root.
