# Copie para .env e preencha com valores apropriados; nunca coloque credenciais reais
# neste arquivo de exemplo nem o versionamento.

# Banco legado
DB_LEGADO_HOST=localhost
DB_LEGADO_PORT=3306
DB_LEGADO_DATABASE=nome_do_banco_legado
DB_LEGADO_USERNAME=usuario_leitura
DB_LEGADO_PASSWORD=troque_esta_senha

# Banco novo local publicado pelo Compose (execução do app diretamente no host).
# Para o app em container e o MySQL do mesmo Compose, use banco-novo:3306.
DB_NOVO_HOST=localhost
DB_NOVO_PORT=3307
DB_NOVO_DATABASE=controle-interno
DB_NOVO_USERNAME=root
DB_NOVO_PASSWORD=troque_esta_senha

# A senha do banco novo também é usada pelo serviço MySQL como senha do root.
